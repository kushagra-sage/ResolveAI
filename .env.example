RESOLVEAI_ENVIRONMENT=local
RESOLVEAI_DATABASE_URL=postgresql+psycopg://resolveai_app:resolveai_app@localhost:5432/resolveai
RESOLVEAI_MIGRATION_DATABASE_URL=postgresql+psycopg://resolveai_owner:resolveai_owner@localhost:5432/resolveai
RESOLVEAI_REDIS_URL=redis://localhost:6379/0
RESOLVEAI_AUTH_MODE=oidc
RESOLVEAI_JWT_ALGORITHM=RS256
RESOLVEAI_JWT_SECRET=replace-with-at-least-32-random-characters
RESOLVEAI_JWT_ISSUER=http://localhost:8080/realms/resolveai
RESOLVEAI_JWT_AUDIENCE=resolveai-api
RESOLVEAI_OIDC_JWKS_URL=http://keycloak:8080/realms/resolveai/protocol/openid-connect/certs
RESOLVEAI_OIDC_ALGORITHMS=RS256
RESOLVEAI_APPROVAL_REFUND_AUTONOMOUS_LIMIT_MINOR=5000
RESOLVEAI_APPROVAL_REFUND_SINGLE_APPROVAL_LIMIT_MINOR=50000
RESOLVEAI_APPROVAL_REFUND_HARD_CEILING_MINOR=100000
RESOLVEAI_APPROVAL_TTL_MINUTES=30
RESOLVEAI_ARTIFACT_ENDPOINT_URL=http://localhost:9000
RESOLVEAI_ARTIFACT_BUCKET=resolveai-artifacts
RESOLVEAI_ARTIFACT_REGION=us-east-1
RESOLVEAI_ARTIFACT_ACCESS_KEY=resolveai-local
RESOLVEAI_ARTIFACT_SECRET_KEY=resolveai-local-change-me
RESOLVEAI_RETENTION_POLICY_PATH=config/retention-policy.json
RESOLVEAI_PROVIDER_DATA_POLICY_PATH=config/provider-data-policy.json
RESOLVEAI_EXTERNAL_ADAPTER_MODE=mock
RESOLVEAI_ADAPTER_TIMEOUT_SECONDS=3
RESOLVEAI_ADAPTER_MAX_ATTEMPTS=2
RESOLVEAI_ERP_BASE_URL=
RESOLVEAI_WMS_BASE_URL=
RESOLVEAI_PAYMENT_BASE_URL=
RESOLVEAI_SHIPMENT_BASE_URL=
RESOLVEAI_EXTERNAL_ADAPTER_API_KEY=
RESOLVEAI_MODEL_PROVIDER_MODE=deterministic
RESOLVEAI_MODEL_BASE_URL=http://localhost:11434/v1
RESOLVEAI_MODEL_NAME=resolveai-local
RESOLVEAI_MODEL_API_KEY=
RESOLVEAI_LOG_LEVEL=INFO
